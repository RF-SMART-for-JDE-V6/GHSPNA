                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="PageName">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:maxLength value="50" />
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="DisplayText">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:maxLength value="100" />
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1" msdata:PrimaryKey="true">
        <xs:selector xpath=".//RFS_Vocabulary" />
        <xs:field xpath="DDType" />
        <xs:field xpath="DDItem" />
        <xs:field xpath="LanguageID" />
        <xs:field xpath="EnvironmentID" />
        <xs:field xpath="WorkflowID" />
        <xs:field xpath="PageName" />
      </xs:unique>
    </xs:element>
  </xs:schema>
